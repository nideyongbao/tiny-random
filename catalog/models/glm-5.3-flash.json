  "summary": "KDA + pooled DSA + mHC；已有 tiny 执行回放，可由结构解释进入真实张量与算子。",
  "pattern": "34 × KDA + 11 × DSA",
  "tiny_status": "目标同名 tiny · 有诊断轨迹",
  "tiny_note": "tiny 为8层、H128、32/top8；基模45层、H4096、288/top8。tiny FP8 专家尺度被重复 pack 覆盖，cached/full 数值一致性失败；已有回放如实保留，不视为基模数值验证。",
  "highlights": [
    "KDA 逐通道 decay，不等于 GDN 标量 decay",
    "DSA learned pooling 选 raw token；参考 indexer 未用 RoPE",
    "mHC Sinkhorn20，最终4路无权 mean"
  ],
  "input": "文本 embedding；图像／视频经24层 ViT（H1024、patch14、temporal2、merge2）投影至H4096后插入视觉占位。语言激活复制为[B,T,4,H] streams。",
  "norm": "mHC先 collapse，再进attention/FFN自己的RMSNorm；KDA输出使用RMSNorm×sigmoid gate。",
  "position": "该配置主 DSA 的 qk_rope_head_dim=0；参考 indexer 也未调用 RoPE，不能因为布尔配置名就画出 RoPE 运算。",
  "residual": {
    "title": "mHC · 4 streams + Sinkhorn20",
    "summary": "Attention/FFN分别拥有pre/post/comb，保留四路残差。",
    "steps": [
      "4H flatten → RMSNorm → linear24",
      "pre=sigmoid+ε / post=2sigmoid",
      "comb softmax+ε → Sinkhorn20",
      "pre加权collapse → 子层",
      "post×子层 + combᵀ×原streams"
    ],
    "equations": [
      "Xnew = post ⊙ block(RMSNorm_sub(Σ preᵢ Xᵢ)) + combᵀ X"
    ],
    "notes": [
      "stream是层间激活，不是自回归cache。",
      "collapse之后还有独立的attention/FFN子层RMSNorm，再进入子层计算。"
    ],
    "sources": [
      "base",
      "code"
    ]
  },
  "output": "HyperHead 对4路做无权 mean → RMSNorm → 可选last-position slice → LM head154880。普通AR不执行MTP。",
  "prefill": "KDA用chunk参考实现；DSA按query可见前缀产生因果稀疏mask。已有tiny CPU eager记录会先物化scores再加mask。",
  "decode": "KDA更新conv与递归矩阵；DSA延长normalized latent与indexer packed cache，再为本轮query选池与尾部。",
  "extra": "已有执行回放为CPU/FP32反量化参考后端，固定18-token prompt；不是基模FP8 GPU性能或数值轨迹。",
  "mtp": "配置1个MTP辅助层；普通AR不执行。基模末层L44是KDA，不是完整12组3:1。",
  "attention": {
    "KDA": {
      "title": "Kimi Delta Attention · GLM implementation",
      "summary": "64 heads×128；逐通道衰减g。输出gate是低秩两层投影。",
      "steps": [
        "Q/K/V projection → concat",
        "depthwise causal conv4 + SiLU",
        "Q/K L2Norm；Q/√128",
        "forget gate + sigmoid β",
        "chunk / recurrent delta rule",
        "RMSNorm × sigmoid(g_b(g_a(x)))",
        "O projection"
      ],
      "equations": [
        "S̃ = exp(g)[..., :, None] ⊙ Sprev",
        "δ = β ⊙ (v − kᵀS̃); Snew=S̃+k⊗δ",
        "g = −5·sigmoid(exp(A_log)·(f_b(f_a(x))+dt_bias))"
      ],
      "notes": [],
      "sources": [
        "base",
        "code"
      ]
    },
    "DSA": {
      "title": "Pooled DSA over low-rank KV",
      "summary": "主干采用压缩latent cache，索引器选raw token位置。",
      "steps": [
        "Q low-rank →64heads",
        "KV latent norm →cache →KV expansion",
        "index Q/K + compression gate + APE",
        "4-token weighted pooling →head score aggregation",
        "top pools →raw indices +≤3tail",
        "causal sparse mask →attention →O"
      ],
      "equations": [
        "base QK head256=NoPE256+RoPE0; V256",
        "tiny QK head32=NoPE32+RoPE0; V256",
        "indexer:32heads×128; raw budget2048(base)/128(tiny)+3"
      ],
      "notes": [
        "indexer_keys 打包 key128+gate128+valid1，共257维。",
        "DSA cache.values为末维0的空rotary key，不是展开后的V。"
      ],
      "sources": [
        "base",
        "code"
      ]
    }
  },
  "moe": {
    "title": "Sigmoid MoE + shared",
    "summary": "前三层Dense；之后288专家选8，另加1共享专家。",
    "steps": [
      "同一输入分成并行分支",
      "各分支独立计算（下图）",
      "routed output + shared output →当前模型的FFN residual更新"
    ],
    "equations": [
      "w = sigmoid(logits)[ids]/Σsigmoid(logits)[ids] ×2.5",
      "expert(x)=Wdown(SiLU(clamp(gate,max10)) ⊙ clamp(up,−10,10))"
    ],
    "notes": [
      "tiny对应32/top8，先3Dense再5MoE。shared不计入top8。",
      "Router的ID/weights控制routed专家分支；原始H同时送入专家投影。Router输出不是送给shared的输入，也不直接加到最终hidden。"
    ],
    "sources": [
      "base",
      "code"
    ],
    "routing_steps": [
      "FP32 linear →sigmoid",
      "score+bias选择top8",
      "取原score[ids]归一化×2.5"
    ],
    "branches": [
      {
        "title": "ROUTER · from original H",
        "steps": [
          "FP32 linear →sigmoid",
          "score+bias选择top8",
          "取原score[ids]归一化×2.5"
        ]
      },
      {
        "title": "ROUTED EXPERTS · from X",
        "steps": [
          "与Router相同的H输入",
          "按expert IDs执行专家gated MLP",
          "按Router weights加权求和"
        ]
      },
      {
        "title": "SHARED BRANCH",
        "steps": [
          "同一H输入",
          "always-on shared gated MLP"
        ]
      }
    ],
    "merge": "routed output + shared output →当前模型的FFN residual更新"
  },

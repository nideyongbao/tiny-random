  "summary": "GatedDeltaNet 与 gated GQA 交替；定长递归状态与增长的 KV cache 并存。",
  "pattern": "[GDN ×3 → gated GQA] ×10",
  "tiny_status": "同家族参考 · 来源 397B",
  "tiny_note": "tiny-random/qwen3.5-moe 的模型卡来自 397B-A17B，不是指定 35B。tiny 为 4 层、128 专家选 10；指定基模为 40 层、256 专家选 8。",
  "highlights": [
    "30 层 GDN + 10 层 gated GQA",
    "GDN 输出门用 SiLU；GQA 输出门用 sigmoid",
    "每层 routed MoE + 独立 sigmoid-gated shared expert"
  ],
  "input": "文本 embedding；图像／视频按原生 processor 生成视觉占位与位置。视觉分支为 Conv3D patch embedding → 27 层 ViT → 2×2 spatial merger → H2048，替换视觉占位的 embedding。纯文本跳过视觉分支。",
  "norm": "主干使用 zero-centered RMSNorm：归一化后乘 (1+w)。GDN 输出再按 head RMSNorm；完整注意力的 Q/K 各自 RMSNorm。",
  "position": "GDN 不用 RoPE；GQA 仅旋转 25% head 维度，使用 interleaved MRoPE，theta=1e7。",
  "residual": {
    "title": "普通单路 residual",
    "summary": "与 Qwen3 一样是两次单路 residual，但 norm 权重采用 1+w。",
    "steps": [
      "zero-centered RMSNorm",
      "GDN / gated GQA",
      "residual add",
      "zero-centered RMSNorm",
      "routed + gated shared MoE",
      "residual add"
    ],
    "equations": [
      "X₁ = X + Attention(Norm₁(X))",
      "X₂ = X₁ + MoE(Norm₂(X₁))"
    ],
    "notes": [],
    "sources": [
      "base",
      "code"
    ]
  },
  "output": "最终 zero-centered RMSNorm → 不绑定的 LM head。MTP 是可选辅助预测路径，普通自回归不默认执行。",
  "prefill": "GDN 对 prompt 使用 chunk 形式的 gated-delta recurrence，并保留最终卷积窗口和状态；GQA 层对所有 query 计算因果注意力。",
  "decode": "GDN 更新一个 token 的卷积窗口与递归矩阵；GQA 追加 K/V，查询历史。一次前向中两种状态并存。",
  "extra": "视觉编码器只在有图像／视频输入时执行；本页为源码级符号数据流，没有视觉激活或真实路由值。",
  "mtp": "配置声明 1 个辅助 MTP 层；与普通 next-token 前向分开。",
  "attention": {
    "GDN": {
      "title": "GatedDeltaNet",
      "summary": "标量衰减 g 对每个 value head 单独设置；不是 KDA 的逐通道衰减。",
      "steps": [
        "QKV projection",
        "depthwise causal conv4 + SiLU",
        "q=L2Norm(q)/√Dk; k=L2Norm(k); head repeat",
        "β=sigmoid(b), g=-exp(A_log)*softplus(a+dt_bias)",
        "gated delta recurrence",
        "head RMSNorm × SiLU(z)",
        "output projection"
      ],
      "equations": [
        "q = L2Norm(q) / √Dk; k = L2Norm(k)",
        "S̃ = exp(g) · Sprev",
        "δ = β · (v − kᵀ S̃)",
        "Snew = S̃ + k ⊗ δ; y = qᵀ Snew"
      ],
      "notes": [
        "基模 16 个 key heads / 32 个 value heads；key 重复 2 次。g 为每个 value head 的标量。"
      ],
      "sources": [
        "base",
        "code"
      ]
    },
    "Gated GQA": {
      "title": "Gated full GQA",
      "summary": "这是完整因果 GQA，不做 QSA 稀疏选择。",
      "steps": [
        "Q + output gate projection",
        "K/V projection",
        "Q/K RMSNorm + 25% MRoPE",
        "K/V cache update",
        "KV按query group逻辑广播（cache仍2heads）",
        "causal GQA softmax @ V",
        "× sigmoid(output gate)",
        "O projection"
      ],
      "equations": [
        "Q:[B,16,T,256]; K,V:[B,2,L,256]",
        "Y = Wo(concat(Attention(Q,K,V) ⊙ sigmoid(z)))"
      ],
      "notes": [],
      "sources": [
        "base",
        "code"
      ]
    }
  },
  "moe": {
    "title": "Softmax MoE + gated shared",
    "summary": "路由分支与共享分支并行；共享专家不占 top-k 名额。",
    "steps": [
      "同一输入分成并行分支",
      "各分支独立计算（下图）",
      "routed output + shared output →当前模型的FFN residual更新"
    ],
    "equations": [
      "yrouted = Σ wᵢ Expertᵢ(x)",
      "yshared = sigmoid(wgate x) · SharedMLP(x)",

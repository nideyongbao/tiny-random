      "residual add",
      "pre-RMSNorm",
      "Dense / MoE",
      "residual add"
    ],
    "equations": [
      "X₁=X+Attention(Norm₁(X))",
      "X₂=X₁+FFN(Norm₂(X₁))"
    ],
    "notes": [],
    "sources": [

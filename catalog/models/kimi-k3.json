      "FP32 linear →sigmoid",
      "score+bias选择top16",
      "原score[ids]归一化×1.0"
    ],
    "branches": [
      {
        "title": "ROUTER · from original H",
        "steps": [
          "读取原H（非latent）",
          "FP32 linear →sigmoid",
          "score+bias选择top16",
          "原score[ids]归一化×1.0"
        ]
      },
      {
        "title": "ROUTED EXPERTS · from X",
        "steps": [
          "原H→latent",
          "按Router IDs执行SiTU experts",
          "按Router weights聚合latent",
          "RMSNorm→project回H"
        ]
      },
      {
        "title": "SHARED / ORIGINAL H",
        "steps": [
          "原始H输入",
          "2个shared SiTU experts",
          "返回H空间"
        ]
      }
    ],
    "merge": "routed output + shared output →当前模型的FFN residual更新"
  },

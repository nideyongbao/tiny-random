  "evidence": "配置与实现核对；非执行轨迹",
  "has_trace": false,
  "category": "窗口混合",
  "modalities": [
    "文本",
    "图像",
    "视频"
  ],
  "summary": "局部／全局 GQA + 并行 Dense/MoE；注意力、专家和输出头都带有容易忽略的额外归一化。",
  "pattern": "[Sliding ×5 → Global] ×5",
  "tiny_status": "同规格 -it tiny · 周期不同",
  "tiny_note": "tiny 来源是同规格 instruction-tuned -it；4 层按 Sliding/Global 1:1 交替，基模 30 层为 5:1。tiny H8，local head32/global64；基模 H2816，local256/global512。",
  "highlights": [
    "每层 Dense 与 routed MoE 并行，不是 Dense→MoE 串联",
    "全局 raw K/V projection 共享，但变换后的 K 与 V 不相同",
    "tied LM head + 30·tanh(logits/30) softcap"
  ],
  "input": "token embedding 先乘 √H。图像／视频由 27 层 H1152 vision encoder（patch16、pooling3）生成视觉 soft tokens，投影后插入占位位置。此 26B 配置 audio_config=null，没有音频分支；hidden_size_per_layer_input=0，没有 per-layer embedding。",
  "norm": "Attention pre/post RMSNorm；Dense 与 routed 分支分别 pre/post norm；合并后再 post-feedforward norm；每层输出还乘 layer_scalar。Q/K 有 RMSNorm，V 用无权重 RMSNorm。",
  "position": "Sliding 全 head RoPE，theta10000；Global 按比例旋转 head 的 25%，theta1e6。num_kv_shared_layers=0，不进行跨层 KV 共享。",
  "residual": {
    "title": "单路残差 + 分支独立归一化",
    "summary": "Attention 后先 norm 再 add；FFN 处 Dense 与 MoE 分别归一化后合并。",
    "steps": [
      "pre-norm → Attention → post-norm",
      "residual add",
      "并行 Dense norm / MoE norm",
      "各分支计算与 post-norm",
      "分支相加 → post-feedforward norm",
      "residual add → layer_scalar"
    ],
    "equations": [
      "X₁ = X + PostAttnNorm(Attention(PreAttnNorm(X)))",
      "X₂ = layer_scalar · (X₁ + FFNPostNorm(DenseBranch(X₁)+MoEBranch(X₁)))"
    ],
    "notes": [],
    "sources": [
      "base",
      "code"
    ]
  },
  "output": "Final norm → 与 embedding 绑定的 LM head → logits softcap=30×tanh(logits/30)。此步骤会改变最终概率，不能只画成普通 linear head。",
  "prefill": "全文本因果 mask；视觉 soft tokens 可使用 vision-specific 双向 mask。每层初始化局部／全局 KV，同时执行 Dense 和 MoE 两条 FFN 分支。",
  "decode": "单 token 查询各层局部窗口或全局历史；独立重新路由，再经过最终 softcapped logits。",
  "extra": "音频与 per-layer embedding 在其他 Gemma 变体可能存在，这个 26B-A4B 配置均不启用。",
  "mtp": "本规格配置未指示普通主干之外的 MTP 模块。",
  "attention": {
    "Sliding GQA": {
      "title": "Sliding GQA · window 1024",
      "summary": "5 个局部层后跟 1 个全局层；这里的窗口是可见性约束。",
      "steps": [
        "Q/K/V projection",
        "Q/K RMSNorm + unweighted V RMSNorm",
        "full-head RoPE（仅Q/K，V不旋转）",
        "local causal mask (1024)",
        "softmax(QKᵀ + mask) @ V",
        "O projection"
      ],
      "equations": [
        "Q:[B,16,T,256]; K,V:[B,8,Lw,256]",
        "attention scaling = 1.0"
      ],
      "notes": [
        "不要套用通用的 1/√head_dim 缩放。物理 cache 是否裁剪依赖后端。"
      ],
      "sources": [
        "base",
        "code"
      ]
    },
    "Global GQA": {
      "title": "Global GQA · shared raw KV projection",
      "summary": "raw K 与 V 共用投影输出；K 的 norm+RoPE 与 V 的 norm 不同。",
      "steps": [
        "Q projection + shared raw KV projection",
        "Q/K RMSNorm, V unweighted RMSNorm",
        "Q/K proportional RoPE 25%",
        "append separate transformed K/V",
        "global causal attention (scale=1)",
        "O projection"
      ],
      "equations": [
        "Q:[B,16,T,512]; K,V:[B,2,L,512]"
      ],
      "notes": [
        "变换后的 K≠V；没有跨层 KV sharing。"
      ],
      "sources": [
        "base",
        "code"
      ]
    }
  },
  "moe": {
    "title": "Parallel Dense + routed MoE",
    "summary": "一个 always-on Dense MLP 与 128/top8 routed experts 并行。Dense branch 不宜简单写成标准 shared_experts=1。",
    "steps": [
      "同一输入分成并行分支",
      "各分支独立计算（下图）",
      "两分支相加 →post-feedforward norm →residual add →layer_scalar"
    ],
    "equations": [
      "r = RMSNorm_no_weight(x) ⊙ channel_scale / √H",
      "w = renorm(softmax(Wr r)[top8]) ⊙ expert_scale[top8]",
      "expert(x)=Wdown(GELU_tanh(Wgate x) ⊙ Wup x)"
    ],
    "notes": [
      "最终 weights 因 per-expert scale 不保证和为1。",
      "基模 Dense intermediate2112，routed704；tiny Dense64，routed32。",
      "Router的ID/weights控制routed专家分支；原始H同时送入专家投影。Router输出不是送给shared的输入，也不直接加到最终hidden。"
    ],
    "sources": [
      "base",
      "code"
    ],
    "routing_steps": [
      "读取pre-FFN residual（非Dense输出）",
      "无权RMSNorm×channel_scale/√H",
      "linear→FP32 softmax→top8 renorm",
      "乘per_expert_scale"
    ],
    "branches": [
      {
        "title": "ROUTER · from residual X",
        "steps": [
          "读取pre-FFN residual（非Dense输出）",
          "无权RMSNorm×channel_scale/√H",
          "linear→FP32 softmax→top8 renorm",
          "乘per_expert_scale"
        ]
      },
      {
        "title": "ROUTED EXPERTS · from residual X",
        "steps": [
          "原residual →MoE input norm",
          "使用Router提供的expert IDs",
          "GELU-gated experts →按weights聚合",
          "MoE post-norm"
        ]
      },
      {
        "title": "DENSE · from residual X",
        "steps": [
          "原residual →dense pre-norm",
          "GELU-gated Dense MLP",
          "Dense post-norm"
        ]
      }
    ],
    "merge": "两分支相加 →post-feedforward norm →residual add →layer_scalar"
  },

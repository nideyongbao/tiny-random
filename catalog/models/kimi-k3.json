  ],
  "summary": "KDA + gated MLA，配合深度 Attention Residuals 与 Stable LatentMoE；三部分都不能套用 GLM。",
  "pattern": "69 × KDA + 24 × gated MLA",
  "tiny_status": "目标同名 tiny · 含实现 patch",
  "tiny_note": "tiny为17层、H8、64/top16、latent256，因此latent投影实际扩维；基模H7168→3584才是降维。tiny对官方代码做兼容patch；不是未经修改源码的逐算子等价副本。",
  "highlights": [
    "末两层都是MLA；full_attn_layers采用1-based索引",
    "AttnRes在深度block轴加权，不是mHC四路",
    "Router读取原H；routed专家在latent空间；shared留在原H"
  ],
  "input": "文本embedding；MoonViT3D27层/H1024/patch14/QKVhidden1536 → PatchMergerMLPV2（2×2空间、sd2_tpool时间）→语言H7168。",
  "norm": "AttnRes先对候选深度状态RMSNorm打分；latent routed aggregate再次RMSNorm后投影回H；末端还有output AttnRes与final RMSNorm。",
  "position": "官方reference MLA设置rotary_emb=None，未应用RoPE。即使config有qk_rope_head_dim64，也不能据此画出旋转算子；实际QK维度为128+64=192。",
  "residual": {
    "title": "Attention Residuals · depth blocks",
    "summary": "对前序深度block摘要和当前block prefix sum做可学习加权，沿深度轴softmax。",
    "steps": [
      "收集depth block summaries + current prefix",
      "候选逐个RMSNorm",
      "独立learned residual projection产生score",
      "softmax over depth blocks",
      "加权组合 →当前子层",
      "更新本轮token的深度候选"
    ],
    "equations": [
      "α = softmax_depth(proj(RMSNorm(depth_candidates)))",
      "x = Σdepth αᵢ · candidateᵢ"
    ],
    "notes": [
      "基模block_size12，tiny8；attention/FFN分别有自己的residual投影。",
      "这些深度候选在每次前向重建，不是跨token缓存；没有固定4-stream轴。"
    ],
    "sources": [
      "base",
      "code"
    ]
  },
  "output": "output AttnRes聚合 → final RMSNorm → LM head163840。num_nextn_predict_layers=0。",
  "prefill": "KDA chunk模式与MLA因果全注意力交替；各token独立形成AttnRes的深度候选。基模最后两层均为MLA。",
  "decode": "KDA在use_cache且q_len=1时走recurrent；reference MLA追加展开后的K/V。每次前向重建当前token的AttnRes深度状态。",
  "extra": "Stable LatentMoE的router读取原始H；shared branch也在原始H，只有routed branch投影到latent空间。不要把所有专家一并放进latent。",
  "mtp": "指定配置num_nextn_predict_layers=0；不额外绘制未声明的MTP。",
  "attention": {
    "KDA": {
      "title": "KDA · separate short convolutions",
      "summary": "独立Q/K/V projection与3个conv4，不同于GLM的拼接卷积边界。",
      "steps": [
        "Q/K/V各自projection",
        "各自short conv4 +SiLU",
        "Q/K L2Norm",
        "per-channel gated delta recurrence",
        "RMSNorm×sigmoid(full-rank g_proj)",
        "O projection"
      ],
      "equations": [
        "state:[B,96,128,128] (base)",
        "Q/K/V各自conv窗口；reference transpose_state_layout=True"
      ],
      "notes": [
        "轴语义不可只凭同样的数值形状套GLM实现。",
        "输出gate为full-rank投影，不是GLM低秩g_a/g_b。"
      ],
      "sources": [
        "base",
        "code"
      ]
    },
    "gated MLA": {
      "title": "Gated Multi-head Latent Attention · NoPE",
      "summary": "Q/KV低秩投影，reference先展开K/V再缓存；不运行稀疏索引器。",
      "steps": [
        "Q low-rank1536 →heads",
        "KV low-rank512 →K/V expansion",
        "append expanded K/V cache",
        "NoPE causal softmax attention",
        "×sigmoid(g_proj(x))",
        "O projection"
      ],
      "equations": [
        "Q/K head=128+64=192; V head=128",
        "reference K:[B,96,L,192]; V:[B,96,L,128]"
      ],
      "notes": [
        "不得将reference缓存标为latent压缩cache；优化引擎可另选存储布局。",
        "rotary_emb=None；没有DSA raw-index mask。"
      ],
      "sources": [
        "base",
        "code"
      ]
    }
  },
  "moe": {
    "title": "Stable LatentMoE + original-H shared",
    "summary": "L0 Dense，之后896专家选16；shared有2个，不占top16。",
    "steps": [
      "同一输入分成并行分支",
      "各分支独立计算（下图）",
      "routed output + shared output →当前模型的FFN residual更新"
    ],
    "equations": [
      "SiTU gate =4·tanh(gate/4)·sigmoid(gate)",
      "up̃ =25·tanh(up/25)",
      "Σ selected sigmoid weights =1.0"
    ],
    "notes": [
      "tiny routed维256大于H8，属于扩维；不要自动标注“压缩一半”。",
      "只有routed分支用latent；router和shared读取原始H。",
      "Router的ID/weights控制routed专家分支；原始H同时送入专家投影。Router输出不是送给shared的输入，也不直接加到最终hidden。"
    ],
    "sources": [
